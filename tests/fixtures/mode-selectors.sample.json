{
  "ColorsPalette": {
    "layer": "palette",
    "order": 1,
    "modes": { "Default": [":root"] }
  },

  "ColorsTheme": {
    "layer": "theme",
    "order": 2,
    "modes": {
      "Light": [":root"]
    }
  },

  "ColorsState": {
    "layer": "state",
    "order": 3,
    "modes": {
      "Default": [":root"],
      "Hover": [".ds-interactive:hover", "[data-state=\"hover\"]"]
    }
  },

  "ColorsOnAccent": {
    "layer": "state",
    "order": 10,
    "modes": {
      "Default": [":root"],
      "onAccent": ["[data-on-accent]"]
    }
  },

  "ColorsElement": {
    "layer": "state",
    "order": 11,
    "modes": {
      "Value": [":root"]
    }
  },

  "ComponentSize": {
    "layer": "scale",
    "order": 4,
    "modes": {
      "L": [":root", "[data-size=\"l\"]"],
      "S": ["[data-size=\"s\"]"]
    }
  },

  "Typography": {
    "layer": "scale",
    "order": 5,
    "modes": { "Default": [":root"] }
  }
}
